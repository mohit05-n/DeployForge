generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String
  role                  String                 @default("DEVELOPER")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  projects              Project[]
  repositoryConnections RepositoryConnection[]
  integrations          IntegrationRecord[]
  auditEvents           AuditEvent[]
  githubAccount         GitHubAccount?

  @@map("users")
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  repository     String
  repoOwner      String?
  repoName       String?
  githubRepoId   Int?
  branch         String          @default("main")
  runtime        String          @default("NODEJS_20")
  buildCommand   String          @default("npm run build")
  startCommand   String          @default("npm start")
  dockerfilePath String?         @default("Dockerfile")
  port           Int             @default(3000)
  environment    String          @default("PRODUCTION")
  region         String          @default("us-east-1")
  target         String          @default("ECS_FARGATE")
  status         String          @default("ACTIVE")
  healthStatus   String          @default("HEALTHY")
  liveUrl        String?
  securityThreshold String          @default("CRITICAL")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  envVars        ProjectEnvVar[]
  deployments    Deployment[]
  securityScans  SecurityScan[]
  auditEvents    AuditEvent[]

  @@unique([userId, slug])
  @@map("projects")
}

model ProjectEnvVar {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  valueEncrypted String
  isSecret       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, key])
  @@map("project_env_vars")
}

model RepositoryConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String    @default("GITHUB")
  repoFullName  String
  repoUrl       String
  defaultBranch String    @default("main")
  status        String    @default("CONNECTED")
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("repository_connections")
}

model Deployment {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitSha         String
  commitMessage     String
  branch            String
  author            String
  trigger           String            @default("MANUAL")
  status            String            @default("PENDING")
  targetEnvironment String            @default("PRODUCTION")
  dockerImageTag    String?
  durationSeconds   Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  errorMessage      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  stages            DeploymentStage[]
  logs              DeploymentLog[]
  securityScans     SecurityScan[]

  @@index([projectId, createdAt])
  @@map("deployments")
}

model DeploymentStage {
  id              String     @id @default(cuid())
  deploymentId    String
  deployment      Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name            String
  order           Int
  status          String     @default("PENDING")
  durationSeconds Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  errorMessage    String?

  @@index([deploymentId, order])
  @@map("deployment_stages")
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  stageName    String?
  level        String     @default("INFO")
  message      String
  timestamp    DateTime   @default(now())

  @@index([deploymentId, timestamp])
  @@map("deployment_logs")
}

model IntegrationRecord {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  name         String
  status       String    @default("DISCONNECTED")
  configJson   String?
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, type])
  @@map("integration_records")
}

model AuditEvent {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  details      String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_events")
}

model GitHubAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId         String
  githubUsername       String
  avatarUrl            String?
  accessTokenEncrypted String
  scope                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("github_accounts")
}

model OAuthState {
  id        String   @id @default(cuid())
  userId    String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([state])
  @@map("oauth_states")
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  deliveryId  String   @unique
  event       String
  repository  String
  status      String
  payloadHash String?
  createdAt   DateTime @default(now())

  @@index([deliveryId])
  @@map("webhook_deliveries")
}

model SecurityScan {
  id                     String                @id @default(cuid())
  projectId              String
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deploymentId           String?
  deployment             Deployment?           @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  commitSha              String
  imageTag               String
  imageDigest            String?
  scanner                String                @default("TRIVY")
  scannerVersion         String?
  status                 String                @default("PENDING") // PENDING, SCANNING, COMPLETED, FAILED
  scanResult             String                @default("PENDING") // PASSED, BLOCKED, ERROR
  blockingPolicyViolated Boolean               @default(false)
  severityThreshold      String                @default("CRITICAL") // CRITICAL, HIGH, MEDIUM, LOW
  criticalCount          Int                   @default(0)
  highCount              Int                   @default(0)
  mediumCount            Int                   @default(0)
  lowCount               Int                   @default(0)
  unknownCount           Int                   @default(0)
  totalCount             Int                   @default(0)
  rawReportJson          String?               @db.Text
  errorMessage           String?
  errorCategory          String?               // DB_DOWNLOAD_ERROR, TIMEOUT, SCANNER_UNAVAILABLE, MALFORMED_OUTPUT, PROCESS_CRASH
  durationSeconds        Int?
  scannedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  vulnerabilities        VulnerabilityRecord[]

  @@index([projectId, createdAt])
  @@index([deploymentId])
  @@map("security_scans")
}

model VulnerabilityRecord {
  id               String       @id @default(cuid())
  scanId           String
  scan             SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  cveId            String
  severity         String       // CRITICAL, HIGH, MEDIUM, LOW, UNKNOWN
  packageName      String
  installedVersion String
  fixedVersion     String?
  title            String?
  description      String?      @db.Text
  primaryUrl       String?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([scanId, severity])
  @@map("vulnerability_records")
}

