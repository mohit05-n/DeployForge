# DeployForge Environment Configuration
# Copy this file to .env for local development

# Database connection (PostgreSQL)
# Default embedded Postgres runs on port 54332 for zero-conflict local development
DATABASE_URL="postgresql://postgres:deployforge_dev@localhost:54332/deployforge?schema=public"

# Session & JWT Configuration
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
SESSION_COOKIE_NAME="deployforge_session"
SESSION_MAX_AGE_SECONDS=604800

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Integrations Configuration (Explicit Mock / Simulated in current phase)
# Do NOT enter real secrets here. External integrations remain disabled or mocked.
GITHUB_CLIENT_ID="mock_gh_client_id"
GITHUB_CLIENT_SECRET="mock_gh_client_secret"
AWS_REGION="us-east-1"
AWS_ROLE_ARN="arn:aws:iam::123456789012:role/DeployForgeMockRole"
JENKINS_SERVER_URL="https://jenkins.mock.internal"
TRIVY_SCANNER_ENABLED="true"
