# DeployForge Environment Configuration
# Copy this file to .env for local development

# Database connection (PostgreSQL)
# Default embedded Postgres runs on port 54332 for zero-conflict local development
DATABASE_URL="postgresql://postgres:deployforge_dev@localhost:54332/deployforge?schema=public"

# Session & JWT Configuration
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
ENCRYPTION_KEY="replace-with-a-secure-32-byte-hex-or-string-for-token-encryption"
SESSION_COOKIE_NAME="deployforge_session"
SESSION_MAX_AGE_SECONDS=604800

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# GitHub Integration Configuration (OAuth & Webhooks)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/integrations/github/callback
GITHUB_CLIENT_ID="your_github_oauth_client_id_here"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret_here"

# GitHub Webhook Secret (HMAC-SHA256 verification)
# Configure this secret in your GitHub repository's Webhook settings
# - Payload URL: http://localhost:3000/api/webhooks/github (or ngrok/public URL in dev)
# - Content type: application/json
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# Cloud & Orchestration Integrations
AWS_REGION="ap-south-1"
# Target Amazon ECR repository URI (e.g. <account-id>.dkr.ecr.ap-south-1.amazonaws.com/deployforge-app)
ECR_REPOSITORY_URI=""

# Jenkins CI/CD Pipeline Configuration
# - JENKINS_URL: URL of the Jenkins controller (e.g. http://localhost:8081 or http://jenkins:8080)
# - JENKINS_JOB_NAME: Name of the target pipeline job (e.g. DeployForge-Build)
# - JENKINS_USERNAME: Dedicated service account with least-privilege permissions
# - JENKINS_API_TOKEN: API token generated for the Jenkins user
# - JENKINS_CALLBACK_SECRET: Secret used to HMAC-sign callbacks to /api/webhooks/jenkins
# - ENABLE_REAL_JENKINS: "true" to dispatch to live Jenkins; "false" for deterministic mock adapter
JENKINS_URL=""
JENKINS_JOB_NAME=""
JENKINS_USERNAME=""
JENKINS_API_TOKEN=""
JENKINS_CALLBACK_SECRET=""
ENABLE_REAL_JENKINS="false"

# Docker Build Worker Configuration
# - BUILD_RUNNER_TYPE: "mock" (default, fast local UI testing) or "docker" (real engine build)
# - ENABLE_REAL_DOCKER_BUILDS: "true" to enable real Docker daemon execution; "false" to enforce simulation
BUILD_RUNNER_TYPE="mock"
ENABLE_REAL_DOCKER_BUILDS="false"

# Optional Payment & Microservice Integrations (Server-side only - never expose to client or NEXT_PUBLIC_)
# - STRIPE_SECRET_KEY: Stripe API secret key (server-side only)
# - PAYPAL_CLIENT_ID: PayPal client ID for payment microservices
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""

# Trivy Security Scanning Configuration (Phase 6)
# - DEFAULT_SECURITY_THRESHOLD: Security-gate blocking threshold ('HIGH,CRITICAL', 'CRITICAL', 'MEDIUM,HIGH,CRITICAL', 'LOW')
# - TRIVY_IMAGE_TAG: Target container image to scan (e.g. deployforge-app:latest)
# - TRIVY_TIMEOUT_SECONDS: Scanner process timeout in seconds (default 180)
DEFAULT_SECURITY_THRESHOLD="HIGH,CRITICAL"
TRIVY_TIMEOUT_SECONDS=180

